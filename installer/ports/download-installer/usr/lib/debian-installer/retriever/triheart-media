#!/bin/sh
set -eu

repository=/usr/lib/triheart/udebs
case "$1" in
	config|cleanup) ;;
	packages) cp "$repository/Packages" "$2" ;;
	retrieve)
		if [ ! -f "$repository/$2" ]; then
			logger -t triheart-media "Missing installer component $2"
			exit 1
		fi
		ln -sf "$repository/$2" "$3"
		;;
	error) exit 2 ;;
	*) exit 1 ;;
esac
