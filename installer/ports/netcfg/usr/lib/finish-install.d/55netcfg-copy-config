#!/bin/sh
set -e

# Reuse the connection generated by netcfg, including static IP and Wi-Fi.
profiles=/etc/NetworkManager/system-connections
for profile in "$profiles"/*; do
	[ -f "$profile" ] || continue
	install -d -m 0700 "/target$profiles"
	install -m 0600 "$profile" "/target$profiles/$(basename "$profile")"
done
