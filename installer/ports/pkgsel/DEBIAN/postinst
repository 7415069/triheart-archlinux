#!/bin/sh
set -e
. /usr/share/debconf/confmodule

fail_step() {
	db_progress STOP || true
	db_input critical triheart/pkgsel/failed || true
	db_go || true
	exit 1
}

db_input high triheart/features || [ "$?" -eq 30 ]
db_go || exit 10

set -- networkmanager sudo plasma-meta plasma-login-manager \
	noto-fonts noto-fonts-cjk noto-fonts-emoji xorg-xwayland xdg-user-dirs \
	packagekit-qt6 flatpak firefox libreoffice-fresh \
	cups cups-filters system-config-printer bluez bluez-utils \
	pipewire-alsa pipewire-pulse wireplumber ufw libmms fwupd vulkan-mesa-layers

# kde-multimedia-meta requires KMix. Keep the other multimedia apps and
# use Plasma's volume control for the system tray.
set -- "$@" kde-accessibility-meta kde-education-meta kde-games-meta kde-graphics-meta \
	kde-network-meta kde-office-meta kde-pim-meta kde-sdk-meta kde-system-meta \
	kde-utilities-meta kdevelop-meta \
	audex audiocd-kio audiotube dragon elisa ffmpegthumbs juk k3b kamoso kasts kdenlive kwave plasmatube

if [ "$(uname -m)" = x86_64 ]; then
	set -- "$@" vulkan-intel vulkan-nouveau
fi

db_get debian-installer/locale || RET=
locale=${RET:-C.UTF-8}
case "$locale" in
	zh_*) set -- "$@" fcitx5 fcitx5-chinese-addons fcitx5-configtool fcitx5-gtk fcitx5-qt ;;
esac
case "$locale" in
	zh_CN*|zh_SG*) set -- "$@" firefox-i18n-zh-cn libreoffice-fresh-zh-cn ;;
	zh_TW*|zh_HK*|zh_MO*) set -- "$@" firefox-i18n-zh-tw libreoffice-fresh-zh-tw fcitx5-chewing ;;
esac

db_get triheart/features
ssh_service=
development=false
case "$RET" in *ssh*) set -- "$@" openssh; ssh_service=sshd.service ;; esac
case "$RET" in *development*) set -- "$@" base-devel jdk11-openjdk jdk8-openjdk; development=true ;; esac

for filesystem in $(awk '!/^#/ && NF >= 4 {print $3}' /target/etc/fstab | sort -u); do
	case "$filesystem" in
		btrfs) set -- "$@" btrfs-progs ;;
		xfs) set -- "$@" xfsprogs ;;
		f2fs) set -- "$@" f2fs-tools ;;
		jfs) set -- "$@" jfsutils ;;
		vfat) set -- "$@" dosfstools ;;
	esac
done

db_progress START 0 100 debian-installer/pkgsel/title
db_progress INFO triheart/pkgsel/install
. /usr/lib/triheart/install-packages
install_packages "$@" || fail_step
db_progress SET 98
db_progress INFO triheart/pkgsel/configure
. /usr/lib/triheart/configure-target
if ! configure_target "$ssh_service" "$locale" "$development"; then
	fail_step
fi
db_progress SET 100
db_progress STOP
