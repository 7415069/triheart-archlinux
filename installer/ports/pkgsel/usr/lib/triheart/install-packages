install_packages() (
	work=$(mktemp -d /tmp/triheart-pkgsel.XXXXXX) || exit 1
	trap 'rm -rf "$work"' EXIT
	mknod "$work/output" p && mknod "$work/events" p || exit 1

	# pacman only prints numeric progress on a terminal.
	LC_ALL=C COLUMNS=160 /usr/lib/triheart/pty-output /usr/lib/triheart/bootstrap-arch \
		pacman -Syu --noconfirm --needed --color never "$@" \
		</dev/null >"$work/output" 2>&1 3>&- &
	pacman_pid=$!
	LC_ALL=C awk -f /usr/lib/triheart/pacman-progress.awk <"$work/output" >"$work/events" 3>&- &
	parser_pid=$!

	# debconf reads its replies on stdin, so consume progress on a separate fd.
	position=0
	previous=
	tab=$(printf '\t')
	while IFS="$tab" read -r phase next detail <&7; do
		if [ "$phase" = log ]; then
			logger -t triheart-pkgsel -- "$detail" || true
			continue
		fi
		if [ "$next" -gt "$position" ]; then
			position=$next
			db_progress SET "$position" || true
		fi
		if [ "$phase:$detail" != "$previous" ]; then
			template="triheart/pkgsel/$phase"
			db_subst "$template" DETAIL "$detail" || true
			db_progress INFO "$template" || true
			previous="$phase:$detail"
		fi
	done 7<"$work/events"
	wait "$parser_pid" || logger -t triheart-pkgsel 'Progress parser exited early'
	wait "$pacman_pid"
)
