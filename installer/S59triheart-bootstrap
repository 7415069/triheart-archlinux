#!/bin/sh

# Sourced by d-i before the frontend and main menu start.
if [ ! -e /run/triheart-bootstrap-registered ]; then
	for component in /usr/lib/triheart/*.udeb; do
		if ! udpkg --unpack "$component"; then
			logger -t triheart-bootstrap "Could not register $component"
			exit 1
		fi
	done
	touch /run/triheart-bootstrap-registered
fi
