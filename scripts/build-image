#!/bin/bash
set -euo pipefail
project=$(cd -- "$(dirname -- "$0")/.." && pwd)
stage=$1 architecture=$2 build=$3 iso_name=$4 profile=$5
sources="$build/01-sources"
components="$build/02-components"
initrd="$build/03-initrd"
iso="$build/04-iso"
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

case "$stage" in
	01-udeb-index)
		mirror="$build/.work/mirror"
		index="$mirror/dists/trixie/main/debian-installer/binary-$architecture/Packages.gz"
		gzip -dc "$index" > "$sources/udebs/Packages"
		mkdir -p "$sources/udebs/local"
		cp -al "$mirror/pool" "$sources/udebs/local/pool"
		awk '
			BEGIN { RS=""; FS="\n"; OFS="\t" }
			$1 ~ /^Package: (user-setup-udeb|netcfg|choose-mirror|apt-setup-udeb|pkgsel|grub-installer|finish-install|partman-efi)$/ {
				package=substr($1,10); file=hash=""
				for(i=2;i<=NF;i++) {
					if($i ~ /^Filename: /) file=substr($i,11)
					if($i ~ /^SHA256: /) hash=substr($i,9)
				}
				print package,file,hash
			}
		' "$sources/udebs/Packages" > "$sources/udebs/selected.tsv"
		[[ $(wc -l < "$sources/udebs/selected.tsv") == 8 ]]
		gzip -dc "$sources/di/$architecture/cdrom/gtk/initrd.gz" | \
			cpio -i --quiet --to-stdout var/lib/dpkg/status > "$initrd/upstream-status"
		sed -n 's/^Package: kernel-image-\(.*\)-di$/\1/p' "$initrd/upstream-status" > "$initrd/kernel.txt"
		kernel=$(cat "$initrd/kernel.txt")
		[[ $kernel =~ ^[a-zA-Z0-9.+-]+-$architecture$ ]]
		# Refuse mixing a point release package tree with a different d-i ABI.
		awk -v kernel="$kernel" '
			/^Kernel-Version: / { if ($2 != kernel) exit 1; found=1 }
			END { if (!found) exit 1 }
		' "$sources/udebs/Packages"
		;;
	02-components)
		if ! command -v xz >/dev/null; then
			apt-get -o Acquire::Retries=3 install -y --no-install-recommends xz-utils
		fi
		dpkg-query -W -f='${Package}\t${Version}\n' cpio curl dpkg gpg gpgv pigz xorriso xz-utils zstd > "$components/build-tools.tsv"

		if [[ $architecture == arm64 ]]; then
			runtime="$work/root.aarch64"
			mkdir "$runtime"
			# Only the runtime for pacstrap is needed on the install medium.
			pigz -dc "$sources/ArchLinuxARM-aarch64-latest.tar.gz" | tar -xf - -C "$runtime" \
				--exclude=./boot --exclude=./usr/lib/modules --exclude=./usr/lib/firmware \
				--exclude=./var/cache/pacman/pkg
			install_scripts=("$sources"/arch-install-scripts-*.pkg.tar.xz)
			tar -xJf "${install_scripts[0]}" -C "$runtime" usr/bin/arch-chroot usr/bin/pacstrap
			cp "$runtime/etc/pacman.d/mirrorlist" "$components/upstream-mirrorlist"
			tar -C "$work" -cf - root.aarch64 | pigz -n > "$components/arch-bootstrap.tar.gz"
		else
			archive=("$sources"/archlinux-bootstrap-*-x86_64.tar.zst)
			zstd -dc "${archive[0]}" | tar -xOf - root.x86_64/etc/pacman.d/mirrorlist > "$components/upstream-mirrorlist"
			zstd -dc "${archive[0]}" | pigz -n > "$components/arch-bootstrap.tar.gz"
		fi
		/bin/sh "$project/scripts/build-mirror-catalog" "$architecture" "$components/upstream-mirrorlist" > "$components/mirrors.tsv"
		"$project/scripts/build-component" "$components" "$architecture"
		mv "$components/bootstrap-base_0.1.0_$architecture.udeb" "$components/bootstrap-base.udeb"
		"$project/scripts/build-ports" "$work" "$sources/udebs" "$components" "$architecture" "$profile"
		for package in "$components"/*.udeb; do
			dpkg-deb --show --showformat='${Package}\t${Version}\t${Architecture}\n' "$package"
		done > "$components/packages.tsv"
		;;
	03-initrd)
		# Local udebs are consumed by native debian-cd and cdrom-retriever.
		# No startup hook, custom retriever or udeb repository in the initrd.
		local_repo="$build/.work/local"
		mkdir -p "$local_repo/pool/local"
		cp -l "$components/"*.udeb "$local_repo/pool/local/"
		index="$local_repo/dists/trixie/local/debian-installer/binary-$architecture"
		mkdir -p "$index" "$local_repo/dists/trixie/local/binary-$architecture"
		(cd "$local_repo" && dpkg-scanpackages --type udeb pool/local /dev/null) > "$index/Packages"
		pigz -nc "$index/Packages" > "$index/Packages.gz"
		pigz -nc </dev/null > "$local_repo/dists/trixie/local/binary-$architecture/Packages.gz"
		apt-ftparchive -o APT::FTPArchive::Release::Codename=trixie \
			-o APT::FTPArchive::Release::Architectures="$architecture" \
			-o APT::FTPArchive::Release::Components='local local/debian-installer' \
			release "$local_repo/dists/trixie" > "$local_repo/dists/trixie/Release"
		cp "$index/Packages" "$components/local-Packages"
		"$project/scripts/prepare-installer-branding" "$architecture" "$build"
		printf 'Upstream cdrom initrd with a branding/font overlay and native firmware handling.\n' > "$initrd/README.txt"
		;;
	04-iso)
		"$project/scripts/build-netinst" "$architecture" "$build" \
			"$(cat "$build/02-netinst/debian-version.txt")" "$profile"
		mv "$build/04-iso/triheart-netinst.iso" "$iso/$iso_name"
		;;
	*) printf 'Unknown ISO build stage %s\n' "$stage" >&2; exit 2 ;;
esac
