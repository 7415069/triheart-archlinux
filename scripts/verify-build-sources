#!/bin/bash
set -euo pipefail

sources=$1
mode=$2 signer=$3

require_signer() {
	awk -v signer="$1" '
		$1 == "[GNUPG:]" && $2 == "VALIDSIG" && ($3 == signer || $NF == signer) { valid = 1 }
		END { exit !valid }
	' "$2"
}

case "$mode" in
	--debian)
		cp /usr/share/keyrings/debian-archive-keyring.gpg "$sources/debian-archive-keyring.gpg"
		gpgv --status-fd 1 --keyring "$sources/debian-archive-keyring.gpg" \
			--output "$sources/debian.Release" "$sources/debian.InRelease" > "$sources/debian-signature.status"
		grep -qx 'Codename: trixie' "$sources/debian.Release"
		gpg --batch --dearmor < "$sources/debian-cd.asc" > "$sources/debian-cd.gpg"
		gpgv --status-fd 1 --keyring "$sources/debian-cd.gpg" \
			"$sources/debian-cd.sha256.sign" "$sources/debian-cd.sha256" > "$sources/debian-cd-signature.status"
		require_signer "$signer" "$sources/debian-cd-signature.status"
		;;
	--arch)
		gpg --batch --dearmor < "$sources/arch-release.asc" > "$sources/arch-release.gpg"
		for signature in "$sources"/*.sig; do
			archive=${signature%.sig}
			status="$archive.signature.status"
			gpgv --status-fd 1 --keyring "$sources/arch-release.gpg" "$signature" "$archive" > "$status"
			require_signer "$signer" "$status"
		done
		;;
	*) exit 2 ;;
esac
