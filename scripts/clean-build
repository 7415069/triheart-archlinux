#!/bin/bash
# Called only after verified publication. Never follows or prunes shared caches.
set -euo pipefail
build=$(cd -- "$1" && pwd -P)
[[ -f $build/published.tsv && -f $build/ARTIFACTS.SHA256SUMS && -d $build/01-sources/project ]] || exit 1
for directory in 01-sources 02-netinst 02-components 03-initrd 04-iso; do
	[[ ! -L $build/$directory ]] || exit 1
done
IFS=$'\t' read -r image hash < <(sed -n '2p' "$build/published.tsv")
[[ -s $image && $image != "$build"/* && $hash =~ ^[0-9a-f]{64}$ ]] || exit 1
if command -v sha256sum >/dev/null; then hash_command=(sha256sum)
else hash_command=(shasum -a 256)
fi
printf '%s  %s\n' "$hash" "$image" | "${hash_command[@]}" --check -
printf 'path\tbytes\n' > "$build/cleanup.tsv"
remove() {
	local path=$1 bytes
	[[ ! -L $path ]] || { printf 'Refusing cleanup symlink %s\n' "$path" >&2; exit 1; }
	[[ -e $path ]] || return 0
	bytes=$(du -sk "$path" | awk '{print $1 * 1024}')
	printf '%s\t%s\n' "${path#"$build"/}" "$bytes" >> "$build/cleanup.tsv"
	rm -rf -- "$path"
}
remove "$build/.work"
for directory in build-packages firmware-metadata; do remove "$build/01-sources/$directory"; done
for directory in "$build/01-sources/di/"*/cdrom; do remove "$directory"; done
remove "$build/01-sources/udebs/local"
remove "$build/03-initrd/overlay"
for path in "$build/01-sources/"*.iso "$build/01-sources/"*.tar.gz "$build/01-sources/"*.tar.zst \
	"$build/01-sources/"*.pkg.tar.xz "$build/01-sources/"*Packages.gz \
	"$build/02-netinst/"*.iso "$build/02-components/"*.udeb "$build/02-components/"*.tar.gz \
	"$build/03-initrd/"*.gz "$build/04-iso/"*.iso; do
	remove "$path"
done
