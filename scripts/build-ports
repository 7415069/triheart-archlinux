#!/bin/bash
set -euo pipefail

project=$(cd -- "$(dirname -- "$0")/.." && pwd)
work=$1 sources=$2 output=$3 architecture=$4 profile=${5:-triheart}

while IFS=$'\t' read -r package archive_path hash; do
	input="$sources/local/$archive_path"
	printf '%s  %s\n' "$hash" "$input" | sha256sum --check -
	stage="$work/port-$package"
	dpkg-deb --raw-extract "$input" "$stage"
	# Preserve the exact upstream scripts, templates and dependencies reviewed
	# for this build before applying the small target-system adaptations.
	cp -a "$stage" "$sources/upstream-$package"
	version=$(dpkg-deb --field "$input" Version)
	sed -i "s/^Version:.*/Version: 2:${version#*:}+triheart1/" "$stage/DEBIAN/control"
	if [[ -d $project/installer/ports/$package ]]; then
		(cd "$project/installer/ports/$package" && tar --exclude=.DS_Store -cf - .) | tar -xf - -C "$stage"
	fi
	case $package in
		choose-mirror)
			install -d "$stage/usr/lib/triheart"
			install -m 0644 "$output/mirrors.tsv" "$stage/usr/lib/triheart/mirrors.tsv"
			install -m 0755 "$project/installer/bootstrap-base/usr/lib/triheart/arch-mirrorlist" "$stage/usr/lib/triheart/arch-mirrorlist"
			if [[ $architecture == arm64 ]]; then
				sed -i 's/Arch Linux/Arch Linux ARM/g' "$stage/DEBIAN/templates"
			fi
			;;
		pkgsel)
			printf '%s\n' "$profile" > "$stage/usr/lib/triheart/profile"
			;;
		apt-setup-udeb) sed -i 's/apt-mirror-setup, //' "$stage/DEBIAN/control" ;;
		grub-installer) sed -i 's/os-prober, //' "$stage/DEBIAN/control" ;;
		partman-efi)
			init="$stage/lib/partman/init.d/50efi"
			grep -Fq '# An ESP is clearly not for BIOS use!' "$init"
			sed -i \
				-e '/^\. \/lib\/partman\/lib\/base.sh$/a . /lib/partman/lib/triheart-efi.sh' \
				-e '/# An ESP is clearly not for BIOS use!/i\
			open_dialog PARTITION_INFO "$id"\
			read_line num ignored_id size type fs path name\
			close_dialog\
			if is_ventoy_efi "$path"; then\
				# Preserve the existing ESP flag through native update.d hooks.\
				mkdir -p "$id"\
				> "$id/old_efi"\
				log "Skipping Ventoy EFI partition $path"\
				continue\
			fi' "$init"
			;;
		finish-install)
			rm "$stage/usr/lib/finish-install.d/10update-initramfs" \
				"$stage/usr/lib/finish-install.d/50config-target-network" \
				"$stage/usr/lib/finish-install.d/60cleanup"
			;;
	esac
	if [[ -f $stage/DEBIAN/triheart.templates ]]; then
		printf '\n' >> "$stage/DEBIAN/templates"
		cat "$stage/DEBIAN/triheart.templates" >> "$stage/DEBIAN/templates"
		rm "$stage/DEBIAN/triheart.templates"
	fi
	dpkg-deb --root-owner-group -Zgzip --build "$stage" "$output/$package.udeb"
done < "$sources/selected.tsv"
