#!/bin/bash
set -euo pipefail
project=$(cd -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
if command -v sha256sum >/dev/null; then hash_command=(sha256sum)
else hash_command=(shasum -a 256)
fi
fixture() {
	build="$work/$1"
	mkdir -p "$build/.work/tree" "$build/01-sources/project" "$build/02-netinst" "$build/02-components" "$build/03-initrd" "$build/04-iso"
	printf 'published ISO\n' > "$work/$1.iso"
	hash=$("${hash_command[@]}" "$work/$1.iso" | awk '{print $1}')
	printf 'path\tsha256\n%s\t%s\n' "$work/$1.iso" "$hash" > "$build/published.tsv"
	printf 'source snapshot\n' > "$build/01-sources/project/source"
	printf 'signature\n' > "$build/01-sources/debian-signature.status"
	printf 'input\n' > "$build/01-sources/debian-netinst.iso"
	printf 'expanded tree\n' > "$build/.work/tree/data"
	ln "$work/$1.iso" "$build/04-iso/output.iso"
	: > "$build/ARTIFACTS.SHA256SUMS"
}
fixture success
bash "$project/scripts/clean-build" "$build"
[[ ! -e $build/.work && ! -e $build/01-sources/debian-netinst.iso && ! -e $build/04-iso/output.iso ]]
[[ -s $build/01-sources/project/source && -s $build/01-sources/debian-signature.status ]]
[[ -s $work/success.iso && -s $build/cleanup.tsv ]]
printf '%s  %s\n' "$hash" "$work/success.iso" | "${hash_command[@]}" --check -

fixture unpublished
rm "$build/published.tsv"
if bash "$project/scripts/clean-build" "$build"; then exit 1; fi
[[ -s $build/.work/tree/data && -s $build/04-iso/output.iso ]]

fixture changed-output
printf 'changed\n' > "$work/changed-output.iso"
if bash "$project/scripts/clean-build" "$build"; then exit 1; fi
[[ -s $build/.work/tree/data ]]

fixture symlink
mv "$build/.work" "$work/external-work"
ln -s "$work/external-work" "$build/.work"
if bash "$project/scripts/clean-build" "$build"; then exit 1; fi
[[ -s $work/external-work/tree/data && -s $work/symlink.iso ]]
printf 'Cleanup publication, preservation and containment checks passed.\n'
